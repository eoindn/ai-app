# Copy to .env (never commit .env). All values are optional.
LEMMS_DATABASE_URL=sqlite:///./lemms.db
# Set true when served over HTTPS
LEMMS_SECURE_COOKIES=false
LEMMS_SESSION_HOURS=8
# Password given to every seeded user by `python -m app.seed`; if unset a random one is printed
LEMMS_SEED_PASSWORD=
